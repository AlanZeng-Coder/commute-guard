{
  "name": "commute-guard",
  "version": "0.1.0",
  "private": true,
  "description": "通勤哨兵：Alameda ferry + SF Muni commute alerts — Worker watch + Claude Code routine analysis",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"checker/test/*.test.mjs\" \"worker/test/*.test.mjs\"",
    "collect": "node checker/collect.mjs",
    "publish": "node checker/publish.mjs",
    "dev": "cd worker && wrangler dev --test-scheduled",
    "deploy": "cd worker && wrangler deploy"
  },
  "dependencies": {
    "gtfs-realtime-bindings": "2.2.0"
  }
}
