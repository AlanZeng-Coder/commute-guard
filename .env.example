# Copy to .env (scripts/setup-cloudflare.sh creates it and fills the generated values).

# https://511.org/open-data/token
API_511_KEY=
# Claude routine API trigger (claude.ai/code/routines → the routine → Add API trigger)
ROUTINE_ID=
ROUTINE_TOKEN=

# --- generated by scripts/setup-cloudflare.sh ---
# https://commute-guard.<you>.workers.dev
CG_BASE_URL=
# Worker WRITE_TOKEN (in the cloud routine this is a network secret instead)
CG_WRITE_TOKEN=
# Password for the app
APP_PASSCODE=
# Web Push keys (node scripts/vapid-keys.mjs)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_JWK=

# Optional backup channel: also push to this ntfy topic
NTFY_TOPIC=
